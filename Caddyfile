{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * /srv
	file_server
	encode gzip

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self)"
	}

	# SPA : tout renvoie vers l'appli mono-fichier
	try_files {path} /index.html
}
